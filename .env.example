# Copia este archivo como .env y rellena las claves que tengas.
# Sin claves funcionan: Noticias, YouTube (scraping) y Bluesky.

# Apify (https://console.apify.com/account/integrations) -> X, Facebook, Instagram, TikTok
APIFY_TOKEN=

# YouTube Data API v3 (gratis, Google Cloud Console) -> búsqueda + comentarios
YOUTUBE_API_KEY=


# NVIDIA (build.nvidia.com) -> clasificación con IA
NVIDIA_API_KEY=

# OpenRouter directo (opcional): tercer proveedor de IA, segundo proveedor de IA
OPENROUTER_API_KEY=

# --- Seguridad al publicar en un servidor (en tu Mac no hace falta nada) ---
# HOST=0.0.0.0                       # escuchar fuera del equipo; exige usuario y clave
# HOSTS_PERMITIDOS=monitor.tudominio.com   # nombres de dominio con los que se accede al panel

# ScrapeCreators (Facebook, Instagram, TikTok) -> segunda ruta en activo-activo con Apify
SCRAPECREATORS_API_KEY=

# --- Al publicar en un servidor (no hace falta en tu Mac) ---
# Primer administrador (solo se usa si todavía no existe ninguna cuenta)
ADMIN_USUARIO=
ADMIN_CLAVE=
# Dominio con el que se accede al panel (en Railway se añade solo)
# HOSTS_PERMITIDOS=monitor.tudominio.com

# CreatorCrawl -> otra ruta para redes sociales
CREATORCRAWL_API_KEY=

# Octoparse (tareas de extracción en la nube; requiere plan Standard o superior)
OCTOPARSE_API_KEY=

# ScrapingBee -> búsqueda en Google de menciones en redes y proxy de respaldo
SCRAPINGBEE_API_KEY=

# RapidAPI (API de Facebook): clave y host de la API elegida
RAPIDAPI_KEY=
RAPIDAPI_FB_HOST=

# Bright Data (Web Scraper API) para Facebook e Instagram
BRIGHTDATA_API_KEY=

# Sincronización de ejemplos entre el monitor local y la nube (misma clave en ambos)
SYNC_TOKEN=
# Solo en el monitor local: dirección del monitor en la nube (https://…)
SYNC_URL=

# Notificaciones al celular con ntfy (canal secreto; ver LEEME)
NOTIFY_NTFY_TOPIC=

# Telegram con sesión (CSIRT). Usa una cuenta dedicada, no la personal. API ID y hash: https://my.telegram.org → API development tools.
# La sesión se genera con: .venv/bin/python server.py --telegram-login (queda aquí y en el portapapeles para Railway)
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION=

# Avisos también en un canal de Microsoft Teams (opcional): en Teams, app Workflows → plantilla
# "Publicar en un chat (o en un canal) cuando se recibe una solicitud de webhook" → copiar la URL; varias separadas por coma
TEAMS_WEBHOOK_URL=
