# Copia este archivo como .env y rellena las claves que tengas.
# Sin claves funcionan: Noticias, YouTube (scraping) y Bluesky.

# Apify (https://console.apify.com/account/integrations) -> X, Facebook, Instagram, TikTok
APIFY_TOKEN=

# YouTube Data API v3 (gratis, Google Cloud Console) -> búsqueda + comentarios
YOUTUBE_API_KEY=

# X API oficial (plan Basic o superior). Si está, se usa en lugar de Apify para X.
X_BEARER_TOKEN=

# NVIDIA (build.nvidia.com) -> clasificación con IA
NVIDIA_API_KEY=

# OpenRouter directo (opcional): tercer proveedor de IA, segundo proveedor de IA
OPENROUTER_API_KEY=

# --- Seguridad al publicar en un servidor (en tu Mac no hace falta nada) ---
# HOST=0.0.0.0                       # escuchar fuera del equipo; exige usuario y clave
# PANEL_USUARIO=
# PANEL_CLAVE=                       # mínimo 12 caracteres
# HOSTS_PERMITIDOS=monitor.tudominio.com   # nombres de dominio con los que se accede al panel

# ScrapeCreators (Facebook, Instagram, TikTok) -> segunda ruta en activo-activo con Apify
SCRAPECREATORS_API_KEY=
