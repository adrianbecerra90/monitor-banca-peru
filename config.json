  "apify": {
    "_nota": "Actores de Apify. Requiere APIFY_TOKEN. Si un actor cambia su esquema, ajusta la plantilla. Variables: {q_lista} términos, {urls}/{urls_obj} URLs, {desde}/{hasta} fechas AAAA-MM-DD, {n_posts}, {n_coment}, {perfiles_tiktok}. Lectura incremental: solo se piden comentarios de publicaciones con comentarios nuevos desde la última revisión.",
    "posts_por_cuenta": 5,
    "posts_por_cuenta_historico": 20,
    "x_busqueda": {
      "actor": "apidojo/tweet-scraper",
      "input": {
        "searchTerms": "{q_lista}",
        "sort": "Latest",
        "maxItems": "{n_max}"
      }
    },
    "facebook_posts": {
      "actor": "apify/facebook-posts-scraper",
      "input": {
        "startUrls": "{urls_obj}",
        "resultsLimit": "{n_posts}",
        "onlyPostsNewerThan": "{desde}",
        "onlyPostsOlderThan": "{hasta}"
      }
    },
    "facebook_comentarios": {
      "actor": "apify/facebook-comments-scraper",
      "input": {
        "startUrls": "{urls_obj}",
        "resultsLimit": "{n_coment}",
        "viewOption": "RECENT_ACTIVITY"
      }
    },
    "instagram_posts": {
      "actor": "apify/instagram-scraper",
      "input": {
        "directUrls": "{urls}",
        "resultsType": "posts",
        "resultsLimit": "{n_posts}",
        "onlyPostsNewerThan": "{desde}"
      }
    },
    "instagram_comentarios": {
      "actor": "apify/instagram-comment-scraper",
      "input": {
        "directUrls": "{urls}",
        "resultsLimit": "{n_coment}"
      }
    },
    "tiktok_busqueda": {
      "actor": "clockworks/tiktok-scraper",
      "input": {
        "profiles": "{perfiles_tiktok}",
        "resultsPerPage": 3,
        "profileScrapeSections": [
          "videos"
        ],
        "profileSorting": "latest",
        "oldestPostDateUnified": "{desde}",
        "newestPostDate": "{hasta}"
      }
    },
    "tiktok_comentarios": {
      "actor": "clockworks/tiktok-comments-scraper",
      "input": {
        "postURLs": "{urls}",
        "commentsPerPost": "{n_coment}"
      }
    },
    "presupuesto_usd_mes": 4.5,
    "x_via_apify": false,
    "comentarios_max_por_post": 200
  },
